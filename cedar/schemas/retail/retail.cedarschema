entity Agent {
    cannot_handle: Bool,
};

entity User {
    email: String,
    orders_count: Long,
    payment_methods_count: Long,
};

entity Order {
    status: String,
    is_pending: Bool,
    is_delivered: Bool,
    user_id: String,
    items_count: Long,
    payment_history_count: Long,
    original_payment_method_id: String,
    is_original_payment: Bool,
    is_same_as_current_payment: Bool,
    is_gift_card: Bool,
    gift_card_balance: Long,
    items_exist_in_order: Bool,
    item_count_matches: Bool,
    has_been_modified_or_cancelled: Bool,
    cancellation_reason: String,
};

entity Product {};

entity System {};

action find_user_id_by_email appliesTo {
    principal: [Agent],
    resource: [User],
};

action find_user_id_by_name_zip appliesTo {
    principal: [Agent],
    resource: [User],
};

action authenticate_user_identity appliesTo {
    principal: [Agent],
    resource: [User],
};

action get_order_details appliesTo {
    principal: [Agent],
    resource: [Order],
};

action provide_order_information appliesTo {
    principal: [Agent],
    resource: [Order],
};

action get_user_details appliesTo {
    principal: [Agent],
    resource: [User],
};

action provide_profile_information appliesTo {
    principal: [Agent],
    resource: [User],
};

action get_product_details appliesTo {
    principal: [Agent],
    resource: [Product, System],
};

action list_all_product_types appliesTo {
    principal: [Agent],
    resource: [Product, System],
};

action provide_product_information appliesTo {
    principal: [Agent],
    resource: [Product, System],
};

action calculate appliesTo {
    principal: [Agent],
    resource: [Product, System],
};

action transfer_to_human_agents appliesTo {
    principal: [Agent],
    resource: [System],
};

action modify_default_user_address appliesTo {
    principal: [Agent],
    resource: [User],
};

action modify_user_address appliesTo {
    principal: [Agent],
    resource: [User],
};

action cancel_order appliesTo {
    principal: [Agent],
    resource: [Order],
};

action cancel_pending_order appliesTo {
    principal: [Agent],
    resource: [Order],
};

action modify_order_shipping_address appliesTo {
    principal: [Agent],
    resource: [Order],
};

action modify_pending_order_address appliesTo {
    principal: [Agent],
    resource: [Order],
};

action modify_order_payment_method appliesTo {
    principal: [Agent],
    resource: [Order],
};

action modify_pending_order_payment appliesTo {
    principal: [Agent],
    resource: [Order],
};

action modify_order_product_item_options appliesTo {
    principal: [Agent],
    resource: [Order],
};

action modify_pending_order_items appliesTo {
    principal: [Agent],
    resource: [Order],
};

action return_order appliesTo {
    principal: [Agent],
    resource: [Order],
};

action return_delivered_order_items appliesTo {
    principal: [Agent],
    resource: [Order],
};

action exchange_order appliesTo {
    principal: [Agent],
    resource: [Order],
};

action exchange_delivered_order_items appliesTo {
    principal: [Agent],
    resource: [Order],
};
