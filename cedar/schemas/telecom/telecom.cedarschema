entity Agent {};

entity User {};

entity Customer {
    account_status: String,
    num_lines: Long,
    num_bills: Long,
    has_payment_method: Bool,
    has_overdue_bill: Bool,
    goodwill_credit_used_this_year: decimal,
};

entity Line in [Customer] {
    status: String,
    roaming_enabled: Bool,
    contract_ended: Bool,
    data_used_gb: decimal,
    data_refueling_gb: decimal,
    plan_id: String,
    requested_refuel_gb: decimal,
};

entity Bill in [Customer] {
    status: String,
    is_overdue: Bool,
    total_due: decimal,
    customer_id: String,
};

entity Plan {
    data_limit_gb: decimal,
    price_per_month: decimal,
    data_refueling_price_per_gb: decimal,
};

entity Device {
    device_type?: String,
    is_esim_capable?: Bool,
    activated?: Bool,
    airplane_mode?: Bool,
    data_enabled?: Bool,
    roaming_enabled?: Bool,
    wifi_enabled?: Bool,
    wifi_calling_enabled?: Bool,
    vpn_connected?: Bool,
    data_saver_mode?: Bool,
    sim_card_missing?: Bool,
    sim_card_status?: String,
};

entity Surroundings {
    line_active: Bool,
    is_abroad: Bool,
    roaming_allowed: Bool,
    mobile_data_usage_exceeded: Bool,
    has_payment_request: Bool,
    payment_amount_due: decimal,
};

entity App {
    installed: Bool,
    has_sms: Bool,
    has_storage: Bool,
    has_phone: Bool,
    has_network: Bool,
};

entity PaymentRequest {
    bill_id: String,
    amount_due: decimal,
    paid: Bool,
};

entity System {};

// Agent Actions
action get_customer_by_phone appliesTo {
    principal: [Agent],
    resource: [Customer],
};

action get_customer_by_id appliesTo {
    principal: [Agent],
    resource: [Customer],
};

action get_customer_by_name appliesTo {
    principal: [Agent],
    resource: [Customer],
};

action get_bills_for_customer appliesTo {
    principal: [Agent],
    resource: [Customer],
};

action get_details_by_id appliesTo {
    principal: [Agent],
    resource: [Customer, Line, Bill, Plan, Device],
};

action get_data_usage appliesTo {
    principal: [Agent],
    resource: [Line],
};

action get_available_plan_ids appliesTo {
    principal: [Agent],
    resource: [Customer, Line, Plan, System],
};

action enable_roaming appliesTo {
    principal: [Agent],
    resource: [Line],
};

action disable_roaming appliesTo {
    principal: [Agent],
    resource: [Line],
};

action suspend_line appliesTo {
    principal: [Agent],
    resource: [Line],
};

action suspend_line_for_overdue_bill appliesTo {
    principal: [Agent],
    resource: [Line],
};

action resume_line appliesTo {
    principal: [Agent],
    resource: [Line],
};

action refuel_data appliesTo {
    principal: [Agent],
    resource: [Line],
};

action send_payment_request appliesTo {
    principal: [Agent],
    resource: [Bill],
};

action transfer_to_human_agents appliesTo {
    principal: [Agent],
    resource: [System],
};

// User Actions
action check_status_bar appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_network_status appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_network_mode_preference appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_data_restriction_status appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_apn_settings appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_wifi_status appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_wifi_calling_status appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_vpn_status appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_sim_status appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_installed_apps appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action run_speed_test appliesTo {
    principal: [User],
    resource: [Surroundings],
};

action check_app_status appliesTo {
    principal: [User],
    resource: [App],
};

action check_app_permissions appliesTo {
    principal: [User],
    resource: [App],
};

action grant_app_permission appliesTo {
    principal: [User],
    resource: [App],
};

action can_send_mms appliesTo {
    principal: [User],
    resource: [App],
};

action toggle_data appliesTo {
    principal: [User],
    resource: [Device],
};

action toggle_roaming appliesTo {
    principal: [User],
    resource: [Device],
};

action toggle_wifi appliesTo {
    principal: [User],
    resource: [Device],
};

action toggle_airplane_mode appliesTo {
    principal: [User],
    resource: [Device],
};

action toggle_data_saver_mode appliesTo {
    principal: [User],
    resource: [Device],
};

action toggle_wifi_calling appliesTo {
    principal: [User],
    resource: [Device],
};

action set_network_mode_preference appliesTo {
    principal: [User],
    resource: [Device],
};

action connect_vpn appliesTo {
    principal: [User],
    resource: [Device],
};

action disconnect_vpn appliesTo {
    principal: [User],
    resource: [Device],
};

action set_apn_settings appliesTo {
    principal: [User],
    resource: [Device],
};

action reset_apn_settings appliesTo {
    principal: [User],
    resource: [Device],
};

action reseat_sim_card appliesTo {
    principal: [User],
    resource: [Device],
};

action reboot_device appliesTo {
    principal: [User],
    resource: [Device],
};

action check_payment_request appliesTo {
    principal: [User],
    resource: [PaymentRequest],
};

action make_payment appliesTo {
    principal: [User],
    resource: [PaymentRequest],
};
